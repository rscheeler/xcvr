+     "text": [
+      "/home/claude/xcvr/src/xcvr/xcvr.py:454: UserWarning: trace_tones: 2 of 2 significant output traces pass a device outside its S-parameter range (gain held at the edge value): IFA, IFBPF, LNA, MX1.\n",
+      "  return trace_tones(self, sources, **kwargs)\n"
+     ]
+    },
