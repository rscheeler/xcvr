+   "source": [
+    "def bandpass(name, f0, bw, il=1.0, order=3):\n",
+    "    \"\"\"Synthetic band-pass (stand-in for a measured .s2p): -il dB in band, steep skirts, -90 dB floor.\"\"\"\n",
+    "    f = np.linspace(0.05e9, 45e9, 900)\n",
+    "    g = np.maximum(-il - 3.0 * (np.abs(f - f0) / (bw / 2)) ** (2 * order), -90)\n",
+    "    s = np.zeros((f.size, 2, 2), complex)\n",
+    "    s[:, 1, 0] = s[:, 0, 1] = 10 ** (g / 20)\n",
+    "    net = skrf.Network(frequency=skrf.Frequency.from_f(f, unit=\"hz\"), s=s)\n",
+    "    return Device(name, \"Synthetic\", \"BPF\", net, nf=ureg.Quantity(il, \"dB\"))\n",
+    "\n",
+    "\n",
+    "kg = np.linspace(5.925e9, 7.125e9, 41)                # 6 GHz band input\n",
+    "kf = xr.DataArray(kg * ureg.Hz, dims=(\"frequency\",), coords={\"frequency\": kg})\n",
+    "ig = np.linspace(0.925e9, 2.125e9, 41)                # L-band IF, for the IF amplifier\n",
+    "kif = xr.DataArray(ig * ureg.Hz, dims=(\"frequency\",), coords={\"frequency\": ig})\n",
+    "rx6 = System(\"RX6\", \"Generic\", \"002\", [\n",
+    "    Constant(\"LNA\", \"G\", \"L\", frequency=kf, gain=25 * ureg.dB, nf=1 * ureg.dB),     # device 1\n",
+    "    bandpass(\"RFBPF\", 6.525e9, 1.4e9),                                              # device 2\n",
+    "    MixerConstant(\"MX1\", \"G\", \"M\", frequency=kf, gain=-8 * ureg.dB, nf=8 * ureg.dB, # device 3\n",
+    "                  lo_freq=5.0 * ureg.GHz, sideband=\"low\", spur_table=table),\n",
+    "    bandpass(\"IFBPF\", 1.525e9, 1.4e9, order=4),                                     # device 4\n",
+    "    Constant(\"IFA\", \"G\", \"I\", frequency=kif, gain=30 * ureg.dB, nf=3 * ureg.dB),     # device 5\n",
+    "])\n",
+    "\n",
+    "# Sweep a -40 dBm tone far beyond the band so out-of-band products are visible too\n",
+    "trace = rx6.trace_tones(ToneSource(np.linspace(1e9, 20e9, 801), -40 * ureg.dBm, \"RF\"), max_order=9)\n",
+    "trace.node_names      # node 0 = input; node k = output of device k"
+   ]
